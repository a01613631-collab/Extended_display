// Copia este archivo a mac/Config/Signing.xcconfig y pon tu Team ID (10 caracteres).
// Para verlo (es el valor de OU=):
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// Si no tienes certificado: Xcode → Settings → Accounts → agrega tu Apple ID →
// Manage Certificates… → + → Apple Development.
// Firmar siempre con la misma identidad evita que macOS "olvide" los permisos
// de Grabación de pantalla y Accesibilidad al recompilar.
DEVELOPMENT_TEAM = ABCDE12345
