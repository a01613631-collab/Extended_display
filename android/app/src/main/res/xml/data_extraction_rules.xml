<?xml version="1.0" encoding="utf-8"?>
<!-- El token de emparejamiento no debe salir de la tablet: nada se respalda ni se transfiere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
